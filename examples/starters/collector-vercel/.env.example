# Required for cross-origin browser ingestion. Separate origins with commas.
TRACELET_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# Optional. Do not embed this long-lived value in public browser code.
# Prefer a same-origin gateway or short-lived credential when authentication is required.
TRACELET_INGEST_TOKEN=replace-with-a-server-side-secret

# Required. Run migrations/001_tracelet_events.sql before accepting traffic.
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
