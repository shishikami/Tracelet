{
  "name": "tracelet-browser",
  "version": "0.1.1",
  "packageManager": "pnpm@10.18.3",
  "private": false,
  "type": "module",
  "description": "A backend-agnostic, privacy-aware analytics SDK for browsers.",
  "license": "MIT",
  "keywords": [
    "analytics",
    "browser",
    "sdk",
    "tracking",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shishikami/Tracelet.git"
  },
  "homepage": "https://tracelet-opal.vercel.app",
  "bugs": {
    "url": "https://github.com/shishikami/Tracelet/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:docs": "pnpm --dir website build",
    "dev:docs": "pnpm --dir website dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:docs": "pnpm --dir website typecheck",
    "check": "pnpm typecheck && pnpm typecheck:docs && pnpm test && pnpm build:docs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepack": "pnpm build",
    "pack:check": "npm pack --dry-run",
    "local:server": "node scripts/local-server.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
